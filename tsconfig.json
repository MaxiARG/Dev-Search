{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "assets/*": ["assets/*"],
      "@molecules/*": ["src/DesignSystem/molecules/*"],
      "@atoms/*": ["src/DesignSystem/atoms/*"],
      "@api/*": ["src/api/*"],
      "@screens/*": ["src/screens/*"],
      "@common-hooks/*": ["src/common-hooks/*"],
      "@common-utils/*": ["src/common-utils/*"],
      "@core/*": ["src/core/*"]
    }
  },
  "include": ["src"]
}
